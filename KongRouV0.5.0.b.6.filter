#--------------------------
# 【17F可選遮蔽規則】OPTIONAL Masking RULES
#--------------------------
### OPTIONAL RULE: Hide random bases
# REMOVE THE BASES YOU --DO-- WANT TO SEE BEFORE SETTING TO HIDE
###修正系統錯誤###
###EA版錯誤集中區##

#------------------------------------
#   [17F-0]預設已開啟"常見遮蔽規則"
#------------------------------------
#「知識卷軸」在輿圖階段隱藏
Hide
Class == "Stackable Currency"
BaseType == "Scroll of Wisdom" 
AreaLevel >= 81
SetFontSize 28

#「一般通貨碎片」在輿圖階段隱藏
Hide
Class == "Stackable Currency"
BaseType "Shard"
AreaLevel >= 79
SetFontSize 36
 
#低品質「藥劑」在地圖階段隱藏，除非有高品質10%以上。
Hide
Quality < 10
AreaLevel <= 79
Rarity <= Magic
Class "Life Flasks" "Mana Flasks"

#無品質藥劑在74+與圖階段隱藏
Hide
AreaLevel >= 74
Rarity = Magic
Class "Life Flasks"
SetBorderColor 255 130 110
SetFontSize 35

Hide
AreaLevel >= 74
Rarity = Magic
Class "Mana Flasks" 
SetBorderColor 80 110 255
SetFontSize 35
