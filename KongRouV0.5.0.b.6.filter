Corrupted False
Mirrored False
Rarity <= Magic
Class "Ring"
BaseType "Abyssal Signet" 
SetBorderColor 153 204 255
SetBackgroundColor 10 10 70 
PlayEffect Blue
MinimapIcon 1 Blue Diamond
SetFontSize 42
DisableDropSound True

# 普通魔法 81+
Show
Class "Ring"
Rarity <= Magic
BaseType "Abyssal Signet"
ItemLevel >= 81
SetBorderColor 153 204 255
SetBackgroundColor 10 10 70 
CustomAlertSound "5_treasures.mp3" 100
PlayEffect Blue
MinimapIcon 1 Blue Diamond
SetFontSize 46
DisableDropSound True

